  status     String    @default("open")
  resolution String    @default("") // admin karar notu
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([status])
  @@map("disputes")
}

// §10.3 — BİLDİRİM OUTBOX'I.
//
// Bildirimler eskiden fire-and-forget gidiyordu: `void push.sendToUser(...)`.
// Ağ hatası, Expo'nun 5xx dönmesi ya da geçersiz token durumunda bildirim
// SESSİZCE kayboluyordu — tekrar denenmiyor, kaydı da tutulmuyordu. Kapora
// süresi dolmak üzere olan bir müşteri haber alamıyordu ve kimsenin haberi
// olmuyordu.
//
// Artık her bildirim önce buraya yazılıyor, sonra teslim ediliyor. Teslim
// başarısızsa satır `pending` kalıyor ve zamanlayıcı artan aralıklarla tekrar
// deniyor.
//
// SAKLAMA: title/body kullanıcı adı taşıyabilir. Bu operasyonel veri, log ya da
// analytics DEĞİL — ama süresiz durmamalı: teslim edilen satırlar zamanlayıcı
// tarafından budanıyor.
model NotificationOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  title         String
  body          String
  dataJson      String    @default("{}") @map("data_json")
  // pending → teslim bekliyor · sent → teslim edildi · dead → deneme hakkı bitti
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

// §12.8 Komisyon dönem faturası — aylık tahakkuk→tahsilat döngüsü.
// status: pending (bekliyor) | collected (ödendi) | overdue (gecikti)
// §11 — ÜYELİK ABONELİĞİ: uzman/salon Premium/Platinum satın alır (app-dışı ödeme + dekont),
// admin dekontu doğrulayıp aktive eder. status: pending | active | rejected | expired.
model Subscription {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  userName    String    @map("user_name")
  tier        String // premium | platinum
  amount      Decimal   @default(0) @db.Decimal(12, 2)
  status      String    @default("pending")
  receiptUri  String?   @map("receipt_uri") // app-dışı ödeme dekontu (Kaspi/banka)
  receiptAt   DateTime? @map("receipt_at") @db.Timestamptz(6)
  periodStart DateTime? @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime? @map("period_end") @db.Timestamptz(6)
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// §profil-onay — SALON/UZMAN profil değişikliği admin onayı olmadan uygulanmaz.
// changes: önerilen alanların JSON'u. status: pending | approved | rejected.
model ProfileChangeRequest {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  userName   String    @map("user_name")
  role       String // professional | salon
  changes    Json // önerilen değişiklikler (name, social, hours, certs, about, address...)
  status     String    @default("pending")
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
  @@map("profile_change_requests")
}

// §12.10 Bildirim Merkezi — segment bazlı toplu duyuru + gönderim geçmişi.
// segment: all | premium | professionals | salons | city
model Announcement {
  id             String   @id @default(uuid()) @db.Uuid
  title          String
  body           String
  // §14.5 — 3 dil: base alanlar tr (kaynak); i18n = { kk: {...}, ru: {...} } üzerine yazar
  i18n           Json?
  segment        String   @default("all")
  city           String? // segment=city ise hedef şehir
  recipientCount Int      @default(0) @map("recipient_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("announcements")
}

// EK Z.1 — Uygulama-içi DM mesajlaşma. 1:1 sohbet: müşteri ↔ uzman/salon.
// Çift (customerId, proUserId) benzersiz → çift başına tek konuşma.
model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  proUserId     String    @map("pro_user_id") @db.Uuid
  // Bağlam (izlenebilirlik) — hangi randevu/talep üzerinden başladı
  bookingId     String?   @map("booking_id")
  requestId     String?   @map("request_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  messages Message[]

  @@unique([customerId, proUserId])
  @@index([customerId])
  @@index([proUserId])
  @@map("conversations")
}

// moderation: ok | flagged (yasaklı ifade — alıcıya gösterilmez, admin kuyruğu)
model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  body           String
  /// EK Z.1 — mesaj fotoğrafı (R2 URL; R2 yoksa data URL).
  ///
  /// DİKKAT: görsel İÇERİĞİ taranmıyor. Metin moderasyonu (numara/dış ödeme
  /// yakalama) yalnız `body` üzerinde çalışır; bir ekran görüntüsündeki Kaspi
  /// QR'ı ya da telefon numarası YAKALANMAZ. Bunu bilerek kabul ediyoruz;
  /// ileride OCR eklenirse burası güncellenmeli. Sohbetteki koruma kartı
  /// kullanıcıyı zaten uygulama dışı ödemeye karşı uyarıyor.
  imageUrl       String?   @map("image_url")
  moderation     String    @default("ok")
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// EK Z.8 — In-app Kaspi ödeme (simülasyon adaptörü; merchant gelince gerçek adaptöre geçilir).
// §8.2 — puan bir ödemenin en fazla %50'sini karşılar; kalan nakit Kaspi ile.
// status: pending | paid | failed | refunded. amount=hizmet bedeli, cashAmount=Kaspi ile ödenen.
model Payment {
  id          String    @id @default(uuid()) @db.Uuid
  bookingId   String    @map("booking_id")
  userId      String    @map("user_id") @db.Uuid
  amount      Decimal   @db.Decimal(12, 2)
  pointsUsed  Int       @default(0) @map("points_used")
  cashAmount  Decimal   @map("cash_amount") @db.Decimal(12, 2)
  /// §8.5 — İNDİRİMİ KİM KARŞILIYOR. Bu alan olmadan puanla ödenen kısmı
  /// sessizce uzman karşılıyordu: müşteri daha az nakit veriyor ama komisyon
  /// tam fiyat üzerinden kesiliyordu. Funding source belirtilmeyen indirim
  /// uygulanamaz.
  /// AYNA_COMMISSION | EXPERT_FUNDED | CAMPAIGN_BUDGET | PARTNER_FUNDED
  fundingSource String  @default("AYNA_COMMISSION") @map("funding_source")
  method      String    @default("kaspi")
  status      String    @default("pending")
  providerRef String?   @map("provider_ref")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([bookingId])
  @@map("payments")
}

// EK Z.5 — Uzaktan push: cihaz Expo push token kaydı. token benzersiz (cihaz başına tek).
model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("push_tokens")
}

// EK Z.3 — Ağır KYC: uzman/salon belge doğrulaması (OTP+yüz tespiti self-publish'e EK).
// documents: string[] belge görsel URI'leri. status: pending | approved | rejected.
model KycVerification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  docType     String    @map("doc_type")
  documents   Json
  status      String    @default("pending")
  note        String    @default("")
  submittedAt DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
  @@map("kyc_verifications")
}

// EK Z.2 — Randevu güvenlik katmanı. Güvenilen kişi (acil durum kişisi).
// phone: PII — ASLA log/analytics'e yazılmaz (CLAUDE.md privacy-by-design).
model TrustedContact {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  phone     String
  relation  String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("trusted_contacts")
}

// Güvenli mod oturumu — konum paylaşımı VARSAYILAN KAPALI; oturum açmak açık rızadır.
// status: active | sos | ended. Ham konum (lastLat/lastLng) log/audit'e yazılmaz.
model SafetySession {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  bookingId      String?   @map("booking_id")
  status         String    @default("active")
  lastLat        Float?    @map("last_lat")
  lastLng        Float?    @map("last_lng")
  lastLocationAt DateTime? @map("last_location_at") @db.Timestamptz(6)
  sosAt          DateTime? @map("sos_at") @db.Timestamptz(6)
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("safety_sessions")
}

// Kullanıcı-kullanıcı engelleme (spec satır 242/257) — engellinin içeriği/mesajı görünmez.
model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

// §keşif katmanı Modül 2 — salon/uzman kampanyaları (Offers). Admin vitrin Campaign'den
// AYRI: sahipli, self-publish (otomatik kural kontrollü), süreli, kotali; randevu kısayolu.
enum OfferStatus {
  draft
  active
  paused
  expired
  removed
}

model Offer {
  id            String      @id @default(uuid()) @db.Uuid
  ownerType     String      @map("owner_type") // salon | expert (hesaptan türetilir)
  ownerUserId   String      @map("owner_user_id") @db.Uuid
  // Randevu hedefi: sahibin keşif kartı (Specialist.proId | Business.professionalId)
  proId         String      @map("pro_id")
  status        OfferStatus @default(active)
  title         String
  description   String      @default("")
  i18n          Json? // kk/ru başlık/açıklama override'ları (mevcut kampanya deseni)
  sector        String      @default("hair") // taksonomi kategori kodu
  discountType  String      @default("percent") @map("discount_type") // percent | fixed_price
  discountValue Decimal     @default(0) @map("discount_value") @db.Decimal(12, 2)
  basePrice     Decimal     @map("base_price") @db.Decimal(12, 2) // indirimsiz referans (KZT)
  finalPrice    Decimal     @map("final_price") @db.Decimal(12, 2) // kampanyalı fiyat
  validDays     Int[]       @default([]) @map("valid_days") // 0=Paz..6=Cmt; boş = her gün
  timeFrom      String      @default("") @map("time_from") // "14:00"; boş = tüm gün (ölü saat hedefi)
  timeTo        String      @default("") @map("time_to")
  startsAt      DateTime    @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime    @map("ends_at") @db.Timestamptz(6) // maks 30 gün
  slotQuota     Int?        @map("slot_quota") // toplam kullanım kotası (null = sınırsız)
  usedCount     Int         @default(0) @map("used_count")
  imageUrl      String      @default("") @map("image_url")
  city          String      @default("") // sahibin şehri (keşif filtresi)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, endsAt])
  @@index([ownerUserId])
  @@map("offers")
}

// §keşif Modül 3 — dönemsel kürasyon (Seasonal Collections): occasion bazlı koleksiyon;
// tarih penceresiyle OTOMATİK yayına girer/çıkar (yıl başında kurulur, elle müdahale yok).
model Collection {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  title     String
  subtitle  String   @default("")
  i18n      Json? // kk/ru title/subtitle override'ları
  // wedding | graduation | nauryz | march8 | ramadan_eid | new_year | summer | custom
  occasion  String   @default("custom")
  heroImage String   @default("") @map("hero_image")
  tone      String   @default("rose") // mevcut paletten (palet dışı renk yok)
  startsAt  DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(6)
  priority  Int      @default(0) // aynı anda çok aktif varsa sıralama (maks 2 hero)
  // Kürasyon öğeleri: [{type:'category'|'article'|'offer'|'expert', id, sort}]
  // (promoJson/servicesJson deseniyle JSON — ayrı tablo yerine yapıya uygun yol)
  itemsJson String   @default("[]") @map("items_json")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([startsAt, endsAt])
  @@map("collections")
}

// ═══════════════════════════════════════════════════════════════════════════
// GÜVEN VE MAHREMİYET — mobil tasarım kanvasının sunucu gerektiren maddeleri
// ═══════════════════════════════════════════════════════════════════════════

/// §21 — Kullanıcı/mesaj şikâyeti. Sohbette dolandırıcılık girişimi bildirildiğinde
/// buraya düşer. KRİTİK: şikâyet edilen kişi bunu ASLA görmez; misilleme korkusu
/// şikâyetin önündeki en büyük engeldir. Yalnız admin kuyruğu okur.
model UserReport {
  id         String   @id @default(uuid()) @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  /// Şikâyet edilen kullanıcı
  targetId   String   @map("target_id") @db.Uuid
  /// off_platform_payment | harassment | no_show | fake_profile | other
  reason     String   @default("other")
  /// Kullanıcının kendi cümlesi (opsiyonel)
  note       String   @default("")
  /// Bağlam: konuşma kimliği (varsa) — inceleme için yazışmaya bakılabilsin
  threadId   String?  @map("thread_id")
  /// open | reviewing | actioned | dismissed
  status     String   @default("open")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetId, createdAt])
  @@index([status, createdAt])
  @@map("user_reports")
}

/// §19 — AYNA Passport: kullanıcının uzmana AÇTIĞINDA görünecek bilgiler.
/// Kalıcı bir profil değil; randevu başına açılan geçici erişimle okunur.
/// SAĞLIK İSTİSNASI: alerjiler randevu onaylanınca otomatik gider — sağlık
/// gizlilikten önce gelir ve bu karar bilerek verilmiştir (kullanıcıya da yazılı).
model UserPassport {
  userId      String   @id @map("user_id") @db.Uuid
  /// Alerji/hassasiyet maddeleri (serbest metin listesi)
  allergies   String[] @default([])
  /// Tercihler — salonda söylemesi zor olanı söylemeden halletmek için
  quietVisit  Boolean  @default(false) @map("quiet_visit")
  noPhotos    Boolean  @default(false) @map("no_photos")
  notifyLate  Boolean  @default(true) @map("notify_late")
  womenOnly   Boolean  @default(false) @map("women_only")
  /// Saç/cilt profili (serbest anahtar-değer; şema kilitlemeden büyüsün)
  traitsJson  String   @default("{}") @map("traits_json")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_passports")
}

/// §19 — Passport erişim kaydı. Spec kritik eylemler için audit log zorunlu kılıyor;
/// burada kaydı YALNIZ BİZ DEĞİL, KULLANICI DA görüyor. Erişim hizmetten 24 saat
/// sonra kendiliğinden kapanır (expiresAt), kullanıcı istediği an kapatabilir.
model PassportAccess {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Erişimi verilen uzman/salon (Professional.id)
  proId      String    @map("pro_id")
  /// Hangi randevu için açıldı
  bookingId  String?   @map("booking_id")
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Kullanıcı erken kapattıysa
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Uzman gerçekten ne zaman baktı (hiç bakmadıysa null)
  lastViewAt DateTime? @map("last_view_at") @db.Timestamptz(6)

  @@index([userId, grantedAt])
  @@index([proId, expiresAt])
  @@map("passport_access")
}

// ── BAKIM (CARE) — kullanıcının kendi girdiği bakım verisi ────────────────
//
// Bu üç tablo YENİ. Bakım sekmesinin tamamı cihazda yaşıyordu: kullanıcı
// rutinini, anlarını ve günlüğünü giriyor, telefonu değişince HEPSİ gidiyordu.
// Sunucuda hiçbir karşılığı yoktu — uç, model, hiçbir şey.
//
// SAĞLIK-YAKINI VERİ: cilt/saç durumu ve kişisel notlar §gizlilik kapsamında.
// Log'a ve analytics'e ASLA yazılmaz; hesap silinince SERT SİLİNİR (finansal
// kayıt gibi saklanmaz) — account-data.service bunu uygular.
//
// TÜRETİLMİŞ DEĞER SAKLANMAZ: mobil model `dueDays`/`daysLeft` taşıyor ama
// onlar ANLIK hesap. Sunucuda saklansalardı zaman donar, kullanıcı yarın
// açtığında hâlâ "3 gün kaldı" görürdü. Kaynak tarih saklanıyor.
model CareRoutine {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String
  icon         String   @default("sparkles-outline")
  /// Bakım döngüsü (gün). "Tamamladım" sayacı buna göre yeniden başlar.
  periodDays   Int      @map("period_days")
  /// §5.4.5 — "Teklif Al" kategoriyi otomatik seçsin (nails, hair…)
  categoryCode String?  @map("category_code")
  /// Son tamamlama. `dueDays` bundan + periodDays'ten HESAPLANIR.
  lastDoneAt   DateTime @default(now()) @map("last_done_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("care_routines")
}

model CareMoment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  icon      String   @default("calendar-outline")
  /// Anın tarihi. `daysLeft` bundan HESAPLANIR.
  happensAt DateTime @map("happens_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, happensAt])
  @@map("care_moments")
}

model CareLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  icon      String   @default("ellipse-outline")
  tone      String   @default("neutral")
  /// Serbest not — kişisel ve hassas. Log'a/analytics'e asla çıkmaz.
  note      String?
  /// Hızlı ekleme türü (düzenlemede çipi geri yüklemek için)
  kind      String?
  loggedAt  DateTime @map("logged_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, loggedAt])
  @@map("care_logs")
}

// ── ALWAYS — sadık müşteri bağı (Platinum) ────────────────────────────────
//
// Bu tablo YENİ ve özellik ondan da yeni: Always TAMAMEN kurguydu.
// `requestAlways` mağazada tanımlıydı ama HİÇBİR YERDEN çağrılmıyordu;
// `alwaysBonds` boş başlıyordu; `SEED_ALWAYS_BONDS` hiçbir yere aktarılmıyordu;
// giriş düğmesinin metni (`always.request_cta` — "Always ol") yazılmış ama
// hiçbir ekranda çizilmiyordu.
//
// Sonuç: Always ekranı HER kullanıcıda kalıcı olarak boştu ve Platinum'un
// satılan ana özelliğinin başlangıç noktası hiç yoktu.
//
// KİMLİK: yerel model yalnız İSİM taşıyordu (providerName/customerName).
// Cihazlar arası bir bağ isimle kurulamaz — iki taraf da kullanıcı kimliğiyle
// saklanıyor. `proId` uzmanın katalog kaydı (profil bağlantısı için).
model AlwaysBond {
  id             String    @id @default(uuid()) @db.Uuid
  customerUserId String    @map("customer_user_id") @db.Uuid
  proUserId      String    @map("pro_user_id") @db.Uuid
  /// Uzmanın/salonun katalog kaydı — profile gitmek ve adı/fotoyu okumak için.
  proId          String    @map("pro_id")
  /// İsteği kim başlattı; karşı taraf kabul eder.
  initiator      String
  /// pending | accepted  (reddedilen SATIR SİLİNİR — "reddedildi" durumu
  /// saklamak, karşı tarafa sessiz bir kara liste tutmak olurdu.)
  status         String    @default("pending")
  /// Müşterinin son aldığı hizmet (bağlam gösterimi)
  lastServiceId  String?   @map("last_service_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)

  /// Aynı çift için İKİNCİ bağ olmaz: tekrar "Always ol" denince yeni satır
  /// açılmamalı, mevcut istek geçerli kalmalı.
  @@unique([customerUserId, proId])
  @@index([proUserId, status])
  @@index([customerUserId, status])
  @@map("always_bonds")
}

// ── KULLANICI TERCİHLERİ ──────────────────────────────────────────────────
//
// Bunlar da YALNIZ CİHAZDA duruyordu: bildirim tercihleri, talep bildirimi
// ayarı, anonim yorum tercihi ve uzmanın otomatik geri çağırma anahtarı.
// Uygulama silinip kurulunca hepsi varsayılana dönüyordu — kullanıcı
// kapattığı bildirimi geri açılmış buluyordu.
//
// TEK SATIR/kullanıcı: tercihler az sayıda ve birlikte okunuyor; ayrı tablo
// başına bir sorgu açmak anlamsız olurdu.
model UserPrefs {
  userId String @id @map("user_id") @db.Uuid
  /// Bildirim türü → açık/kapalı. Anahtar kümesi istemcide tanımlı; burada
  /// serbest JSON çünkü yeni tür eklemek migration gerektirmemeli.
  notifJson String @default("{}") @map("notif_json")
  /// §5.3 — yeni talep bildirimi ayarları (kategori/şehir filtresi)
  demandJson String @default("{}") @map("demand_json")
  /// §7.1 — yorumların varsayılan olarak anonim gönderilmesi
  reviewAnonymous Boolean @default(false) @map("review_anonymous")
  /// §11 — uzmanın otomatik geri çağırma anahtarı (varsayılan AÇIK)
  autoReengage Boolean @default(true) @map("auto_reengage")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_prefs")
}

// ── GERİ ÇAĞIRMA — gönderildi kaydı ───────────────────────────────────────
//
// Geri çağırma da kurguydu: `runAutoReengage` SEED verisi (`SELLER_PAST_CLIENTS`)
// üzerinde dönüyor ve YEREL bildirim üretiyordu. Gerçek müşteriye hiçbir şey
// gitmiyordu; üstelik yalnız uzman uygulamayı açtığında çalışıyordu.
//
// Artık sunucu zamanlayıcısı yapıyor. Bu tablo İKİ KEZ GÖNDERMEYİ engelliyor:
// zamanlayıcı saatte bir dönüyor, kayıt olmasa aynı müşteriye aynı gün
// defalarca bildirim giderdi.
model ReengageSent {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id")
  /// pre (1 gün kala) | due (bitiş günü)
  stage     String
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@unique([bookingId, stage])
  @@map("reengage_sent")
}

/// Brief §4.10 — İADE KUYRUĞU.
///
/// İade hakkı doğduğunda müşteri kartında "Depozito iade et" açılır, Kaspi/hesap
/// bilgisi alınır ve talep admin panelindeki "İadeler" kuyruğuna düşer.
/// Müşteri no-show'unda uzmana ödenecek %9 da AYNI kuyruktan işlenir (§4.8) —
/// iki ayrı ödeme yolu kurmak, para akışında ikinci bir kural demekti.
model RefundRequest {
  id          String    @id @default(uuid()) @db.Uuid
  bookingId   String    @map("booking_id") @db.Uuid
  /// Parayı ALACAK kişi: iade müşteriye, %9 payı uzmana gider.
  payeeUserId String    @map("payee_user_id") @db.Uuid
  /// musteri_iade | uzman_payi
  kind        String
  amount      Decimal   @db.Decimal(12, 2)
  /// Müşterinin/uzmanın verdiği Kaspi ya da banka hesabı. PII: panelde yalnız
  /// ödeme yapan admin görür, log'a ve analitiğe ASLA yazılmaz.
  payoutInfo  String    @default("") @map("payout_info")
  /// bekliyor | odendi | reddedildi
  status      String    @default("bekliyor")
  note        String    @default("")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(6)

  /// Aynı randevu için aynı türde İKİ iade kaydı açılamaz — çift ödeme demekti.
  @@unique([bookingId, kind])
  @@index([status])
  @@map("refund_requests")
}

/// Brief §4.8 — UZLAŞMA KAYDI. "Gelmedi" beyanına ya da ödeme itirazına karşı
/// taraf 24 saat içinde itiraz ederse açılır; admin panelinde çözülür.
model Reconciliation {
  id          String    @id @default(uuid()) @db.Uuid
  bookingId   String    @unique @map("booking_id") @db.Uuid
  /// no_show | odeme
  kind        String
  /// İtirazı AÇAN taraf.
  openedBy    String    @map("opened_by") @db.Uuid
  reason      String    @default("")
  /// İtiraz ekranında eklenen fotoğraf/konum kanıtı (§4.8).
  evidence    String[]  @default([])
  /// bekliyor | cozuldu
  status      String    @default("bekliyor")
  /// AYNA ekibinin telefon teyidi notu (§8.3).
  adminNote   String    @default("") @map("admin_note")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([status])
  @@map("reconciliations")
}
