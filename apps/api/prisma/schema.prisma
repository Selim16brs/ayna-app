// AYNA — başlangıç Prisma şeması (EPIC 1 foundation)
// Tam veri modeli: docs/planning/03-erd-draft.md
// Tarihler UTC (timestamptz). Hassas alanlar uygulama katmanında şifrelenir (docs/security/03).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  professional
  salon
  moderator
  admin
}

// Faz 4 (§15) — salonun, üyenin takvimi üzerindeki yetkisi (UZMAN belirler)
enum CalendarPermission {
  view_availability_only // salon yalnız dolu/boş görür; adına kayıt ekleyemez
  create_requires_approval // salon ekler → uzman onayına düşer (varsayılan)
  manage_calendar // salon eklemesi doğrudan kesinleşir (fiyat/gelir görünürlüğü VERMEZ)
}

enum UserStatus {
  active
  suspended
  deleted
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  // Telefon uygulama katmanında şifreli saklanır (S2). Aramayı destekleyen hash ayrı tutulur.
  phoneHash       String     @unique @map("phone_hash")
  phoneEnc        Bytes      @map("phone_enc")
  // Hesap (parola tabanlı kayıt/giriş — müşteri tarafı OTP'siz)
  name            String     @default("")
  email           String?    @unique
  city            String?
  // §4.6 — women-only yaklaşımı: kayıtta cinsiyet (female | unspecified)
  gender          String     @default("unspecified")
  passwordHash    String     @default("") @map("password_hash")
  role            UserRole   @default(user)
  status          UserStatus @default(active)
  // §12.3 ceza takip — kısıtlı mod (7 gün sayaçlı); süre dolunca kalıcı engel adayı
  restrictedAt    DateTime?  @map("restricted_at") @db.Timestamptz(6)
  restrictReason  String?    @map("restrict_reason")
  // §4.4 — kalıcı engel 2. katman: cihaz parmak izi (HMAC'lenmiş, platform-izinli tanımlayıcı).
  // Telefon OTP birinci katman; yüz eşleşme (biyometrik) ileri faz — burada TUTULMAZ.
  deviceHash      String?    @map("device_hash")
  // AI (§13.5): premium + ortak aylık kota sayacı
  isPremium       Boolean    @default(false) @map("is_premium")
  aiUsed          Int        @default(0) @map("ai_used")
  aiPeriod        String     @default("") @map("ai_period")
  // §11 — üyelik katmanı (free | premium | platinum) + bitiş; admin onayıyla aktifleşir.
  avatarUrl       String?    @map("avatar_url") // profil foto (data URL; medya fazında objeye taşınır)
  birthDate       DateTime?  @map("birth_date") @db.Timestamptz(6) // doğum günü kutlamaları (§CRM)
  cutoutUrl       String?    @map("cutout_url") // §5.1.1 arka planı kesik portre — kredi tekrar YANMAZ
  membershipTier  String     @default("free") @map("membership_tier")
  // K4.2 — para puan KULLANIM KİLİDİ. Bakiye ilk kez eşiği (admin ayarı
  // `rate.points_unlock_kzt`, varsayılan 5.000 ₸) geçtiğinde damgalanır ve BİR
  // DAHA KAPANMAZ: harcayıp eşiğin altına düşmek kullanıcıyı yeniden kilitlemez.
  // Aksi hâlde eşiğin hemen altındaki bir kullanıcı hiç harcayamaz duruma
  // düşerdi. null = henüz açılmadı.
  pointsUnlockedAt DateTime? @map("points_unlocked_at") @db.Timestamptz(6)
  prefsJson       String     @default("{}") @map("prefs_json") // favoriler+adresler (hesap verisi)
  membershipUntil DateTime?  @map("membership_until") @db.Timestamptz(6)
  // §4.6 — telefon OTP doğrulaması (mock SMS)
  phoneVerified   Boolean    @default(false) @map("phone_verified")
  // EK Z.3 — ağır KYC (uzman/salon belge doğrulaması): none | pending | approved | rejected
  kycStatus       String     @default("none") @map("kyc_status")
  kycVerifiedAt   DateTime?  @map("kyc_verified_at") @db.Timestamptz(6)
  // EK Z.6 — müşteri referans programı: kişiye özel kod + davet eden (tek sefer set)
  referralCode    String?    @unique @map("referral_code")
  referredBy      String?    @map("referred_by") @db.Uuid
  // §8.2 (D9) — referans ödülü ÖDENDİ damgası. Ödül artık kod kullanıldığında
  // değil, davet edilenin İLK TAMAMLANMIŞ randevusundan sonra veriliyor; bu alan
  // ödülün iki kez yazılmasını engelliyor. Kuralın öncesinde davet kullanan
  // hesaplar migration'da damgalandı — onlar zaten ödenmişti.
  referralRewardedAt DateTime? @map("referral_rewarded_at") @db.Timestamptz(6)
  defaultLocale   String     @default("ru") @map("default_locale")
  timezone        String     @default("Asia/Almaty")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

// Kritik eylemlerin denetim kaydı — docs/security (EK H.5). safe_diff hassas veri içermez.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorRole    String?  @map("actor_role")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  requestId    String?  @map("request_id")
  ipHash       String?  @map("ip_hash")
  deviceHash   String?  @map("device_hash")
  safeDiff     Json?    @map("safe_diff")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@map("audit_logs")
}

// Özellik bayrakları — hassas özellikler önce internal beta (EK D.4).
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  // Yüzde / rol bazlı kademeli açılış için opsiyonel kural seti.
  rules       Json?
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

// --- Teklif/talep çekirdek akışı (docs/planning/09) ---

model ServiceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameTr    String   @map("name_tr")
  icon      String
  tone      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  quoteRequests QuoteRequest[]

  @@map("service_categories")
}

enum ProBadge {
  campaign
  verified
  today
}

enum ProviderKind {
  salon
  independent
}

model Professional {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  specialty       String
  sector          String       @default("hair") // ana alan (geriye dönük uyum)
  // §5.1.4 — uzmanın hizmet verdiği TÜM alanlar. Tek `sector` yetmiyordu:
  // saç + tırnak yapan uzman yalnız saçta görünüyordu. Hizmet listesinden
  // türetilir (@ayna/domain sectorsFromServiceIds).
  sectors         String[]     @default([])
  kind            ProviderKind @default(salon)
  city            String       @default("") // §5.1.4 — harita/arama şehir filtresi
  district        String       @default("")
  lat             Float? // §5.1.4 — gerçek konum (kayıtta haritadan seçildi); yoksa şehir merkezine yakın
  lng             Float?
  about           String       @default("")
  rating          Decimal      @default(0) @db.Decimal(2, 1)
  reviewCount     Int          @default(0) @map("review_count")
  experienceYears Int          @default(0) @map("experience_years")
  priceFrom       Decimal      @default(0) @map("price_from") @db.Decimal(12, 2)
  friends         Int?
  imageUrl        String       @map("image_url")
  portfolio       String[]     @default([]) // uzman galerisi (data URL; medya fazında objeye)
  promoJson       String       @default("[]") @map("promo_json") // §11 Platinum promosyonları (kendi profilinde görünür)
  servicesJson    String       @default("[]") @map("services_json") // §9.5 uzmanın GERÇEK hizmet/fiyat listesi
  hoursJson       String       @default("[]") @map("hours_json") // §9.5 çalışma saatleri (DayHours[])
  closedDaysJson  String       @default("[]") @map("closed_days_json") // §4.6 izin/tatil günleri (UTC ms)
  badge           ProBadge     @default(verified)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  quotes Quote[]

  @@map("professionals")
}

enum QuoteRequestStatus {
  open
  closed
}

enum LoyaltyKind {
  earn
  spend
}

// Sadakat defteri — append-only. Bakiye girişlerin toplamından türetilir (finans kuralı).
model LoyaltyEntry {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  kind      LoyaltyKind
  reason    String // i18n anahtarı (örn. 'rewards.earn.review')
  detail    String      @default("")
  points    Int // earn pozitif, spend negatif
  // §8 — kazanılan puanın son kullanma tarihi (12 ay); spend/expire kayıtlarında null
  expiresAt DateTime?   @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("loyalty_entries")
}

enum BookingSource {
  direct
  photo_quote
  demand
}

enum BookingStatus {
  // Kaynak: AYNA_RANDEVU_AKISI_BRIEF.md §3 (tek doğruluk kaynağı).
  //
  // Kod, veritabanı, panel ve belge AYNI adları kullanıyor — arada çeviri
  // katmanı yok, dolayısıyla çeviri hatası da yok. Eski makinenin (confirmed /
  // deposit_pending / completed_pending ...) hiçbir değeri BIRAKILMADI: brief
  // "eskisi komple silinsin, hiçbir çakışma olmasın" diyor.
  taslak // müşteri talebi hazırlıyor; slot tutulmaz
  onay_bekliyor // talep gönderildi, SLOT KİLİTLİ, uzmanın 3 saati işliyor
  degisiklik_onerildi // uzman tarih/saat/hizmet değiştirdi
  karsi_oneri // müşteri farklı slot önerdi (tek tur)
  depozito_bekliyor // uzman onayladı; müşterinin 10 dakikası işliyor
  kesinlesti // dekont yüklendi (admin doğrulaması SONRA)
  erteleme_onerildi // yeni slot önerildi; depozito taşınacak
  hizmet_gunu // randevu saati geldi
  odeme_bekliyor // hizmet bitti; kalan %90 uzmana doğrudan ödenecek
  tamamlandi // uzman "ödeme aldım" dedi (ya da 24 saat doldu)
  degerlendirme // 7 günlük değerlendirme penceresi
  kapandi
  iptal_musteri
  iptal_uzman
  otomatik_dustu // uzman cevapsız VEYA depozito süresinde ödenmedi
  no_show_musteri
  no_show_uzman
  uyusmazlik // itiraz → admin uzlaşma kaydı
}

// Randevu kaydı. id istemci tarafından üretilir (mobil store ile tutarlı).
// Onay/alternatif pazarlık döngüsü (Build Brief §1.6).
model Booking {
  id                String        @id
  // §5.6/çift-yönlü puanlama önkoşulu: randevuyu sahibine bağlar (offline'da null)
  userId            String?       @map("user_id") @db.Uuid
  source            BookingSource
  service           String
  proId             String?       @map("pro_id")
  proName           String        @map("pro_name")
  proImage          String        @map("pro_image")
  uzmanName         String?       @map("uzman_name")
  // §2.2/§5 — offline (salon kaydı) randevuda müşteri adı
  customerName      String?       @map("customer_name")
  // §6.C/Faz3 — randevu türü (normal | group | express) + grup kişi sayısı
  bookingKind       String        @default("normal") @map("booking_kind")
  groupSize         Int?          @map("group_size")
  dateLabel         String        @map("date_label")
  proposedDateLabel String?       @map("proposed_date_label")
  inDays            Int           @map("in_days")
  // §4.2 — kesin zaman (atomik slot lock için); mobil startMs/durationMin'den
  startAt           DateTime?     @map("start_at") @db.Timestamptz(6)
  durationMin       Int?          @map("duration_min")
  // §4.1 — uzmanın önerdiği alternatif başlangıç (mobil proposedStartMs ile hizalı)
  proposedStartAt   DateTime?     @map("proposed_start_at") @db.Timestamptz(6)
  price             Decimal       @db.Decimal(12, 2)
  // Satır talep GÖNDERİLDİĞİNDE doğar; `taslak` yalnız istemcide yaşar
  // (brief §4.1 stepper). Bu yüzden varsayılan onay bekleme.
  status            BookingStatus @default(onay_bekliyor)
  // §6.C — iptal sebebi (kullanıcı "neden gelemiyorum" iletebilir)
  cancelReason      String?       @map("cancel_reason")
  // §3 — İPTALİ KİM YAPTI: customer | provider | admin | system.
  // Şartname ayrı `CUSTOMER_CANCELLED` / `PROVIDER_CANCELLED` durumları istiyor;
  // burada tek `cancelled` durumu + bu alan kullanılıyor. Sonuç aynı (iptal
  // politikası artık kayıttan okunabiliyor) ama mevcut durum makinesi, mobil
  // ekranlar ve geçmiş kayıtlar bozulmuyor — şartname §"kavramsal modelleri
  // mevcut mimariye uyarlayarak" bunu açıkça mümkün kılıyor.
  //
  // Eskiden bu bilgi HİÇBİR YERDE yoktu: kapora kime kalacak sorusu durumdan da
  // alandan da türetilemiyordu, yalnız `depositForfeited` bayrağından dolaylı
  // tahmin edilebiliyordu.
  // §7.8 — kullanılan ücretsiz erteleme sayısı. Sınır admin ayarı
  // (`policy.free_reschedules`, varsayılan 1); sürekli erteleme kötüye
  // kullanımını engeller.
  rescheduleCount   Int           @default(0) @map("reschedule_count")
  cancelledBy       String?       @map("cancelled_by")
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  // §4.1-4.4 — depozito/iade alanları
  depositAmount     Int?          @map("deposit_amount") // KZT kapora tutarı
  depositReceiptUri String?       @map("deposit_receipt_uri") // müşterinin depozito dekontu
  /// Brief §4.4 — dekont yüklenince randevu HEMEN kesinleşir; admin doğrulaması
  /// SONRA yapılır. Bu alan doluysa admin baktı demektir; boşsa "Dekont
  /// doğrulama" kuyruğunda bekliyor (§8.1). Sahte çıkarsa randevu iptal edilir
  /// ve kullanıcı yasaklanır.
  depositVerifiedAt DateTime?     @map("deposit_verified_at") @db.Timestamptz(6)
  refundReceiptUri  String?       @map("refund_receipt_uri") // uzmanın iade dekontu
  depositDeadline   DateTime?     @map("deposit_deadline") @db.Timestamptz(6) // dekont son yükleme
  depositForfeited  Boolean       @default(false) @map("deposit_forfeited") // geç iptal/no-show: kapora yandı
  providerNoShow    Boolean       @default(false) @map("provider_no_show") // uzman gelmedi
  /// §4.6 — salon randevuyu BAŞKA uzmana devrettiğinde önceki uzmanın adı.
  /// Devretme akışının tamamı istemcide yaşıyordu: salon devrediyor, müşteri
  /// onaylıyor, hiçbiri sunucuya yazılmıyordu — uygulama yeniden açılınca
  /// hydrate sunucudaki eski durumu geri getiriyor ve işlem KAYBOLUYORDU.
  reassignedFrom    String?       @map("reassigned_from")
  /// §7.3 — uzmanın hizmet sonrası müşteri hakkındaki GİZLİ sinyali ('up'|'down').
  ///
  /// MÜŞTERİYE ASLA GÖNDERİLMEZ. mapBooking bunu varsayılan olarak GİZLER ve
  /// yalnız sağlayıcı yolunda açar (kapalı-varsayılan): bir alanı yanlışlıkla
  /// açık bırakmak, kadına "sorunlu" etiketlendiğini göstermek demekti.
  /// Eskiden yalnız telefonda yaşıyordu; yeniden kurulumda kayboluyordu.
  providerSignal    String?       @map("provider_signal")
  // §keşif Modül 2 — kampanyadan gelen randevu (iptal/no-show'da kota iade edilir)
  offerId           String?       @map("offer_id") @db.Uuid
  // §2.2/§10 — salon offline kaydı alanları (mobil hydrate'te KAYBOLMAMALI)
  customerPhone     String?       @map("customer_phone") // walk-in müşteri koordinasyon
  bySalon           Boolean       @default(false) @map("by_salon") // salonun aldığı kayıt
  // §4.1.3 — uzman yanıt penceresi SUNUCUDA üretilir (6 saat); yanıt anı metriği
  responseDeadline  DateTime?     @map("response_deadline") @db.Timestamptz(6)
  respondedAt       DateTime?     @map("responded_at") @db.Timestamptz(6)
  // A3 — SLOT BENZERSİZLİĞİ (veritabanı seviyesinde).
  //
  // Değeri `<proId>@<startAt UTC>`, YALNIZ randevu slot işgal eden bir durumdayken
  // (confirmed | deposit_pending | deposit_submitted); diğer her durumda NULL.
  // Postgres NULL'ları birbirinden farklı saydığı için iptal/tamamlanmış randevular
  // aynı saatte istediği kadar birikebilir — ama AYNI ANDA yalnız biri slotu tutar.
  //
  // Kolonu uygulama kodu DEĞİL, `bookings_slot_key` trigger'ı doldurur
  // (`slot-key.sql`). Böylece updateMany, ham SQL ve ileride yazılacak her yeni
  // kod yolu kısıtın içinde kalır — kimse doldurmayı unutamaz.
  slotKey           String?       @unique @map("slot_key")
  // Faz 2 — finans güvenliği
  receiptHash       String?       @unique @map("receipt_hash") // dekont içeriği sha256 — aynı dekont iki kez kullanılamaz
  refundReceiptHash String?       @unique @map("refund_receipt_hash")
  finalizeDeadline  DateTime?     @map("finalize_deadline") @db.Timestamptz(6) // tamamlandı/no-show teyit penceresi sonu
  // §12.8 — randevunun TAMAMLANDIĞI an. Komisyon dönemi buna göre belirlenir.
  // Eskiden dönem `createdAt` ile filtreleniyordu: haziranda oluşup ağustosta
  // tamamlanan randevu HİÇBİR dönemde faturalanmıyordu (haziran dönemi kapandığında
  // henüz tamamlanmamış, ağustos döneminde ise createdAt penceresi dışında).
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz(6)
  reviewed          Boolean       @default(false)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status])
  @@map("bookings")
}

model QuoteRequest {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String?            @map("user_id") @db.Uuid
  categoryId String             @map("category_id") @db.Uuid
  note       String?
  photoUrl   String?            @map("photo_url")
  status     QuoteRequestStatus @default(open)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  // §5.2 Faz A — reverse marketplace gerçek akış alanları
  mode               String    @default("photo") // photo | describe
  city               String    @default("") // §9.3 — teklif hakkı aynı şehirdeki uzmanlarda
  budget             Decimal?  @db.Decimal(12, 2)
  collectMin         Int       @default(180) @map("collect_min")
  // Faz 5 (§19) — kademeli bildirim dalgası: tüm şehre aynı anda push atılmaz
  notifyWave         Int       @default(0) @map("notify_wave")
  waveAt             DateTime? @map("wave_at") @db.Timestamptz(6)
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(6)
  serviceId          String?   @map("service_id") // taksonomi alt hizmet (opsiyonel)
  bookingId          String?   @map("booking_id") // seçim sonrası oluşan randevu
  selectedQuoteId    String?   @map("selected_quote_id") // kazanan teklif
  preferredSlotsJson String    @default("[]") @map("preferred_slots_json") // kullanıcının İSTEDİĞİ saatler (UTC ms)

  category ServiceCategory @relation(fields: [categoryId], references: [id])
  quotes   Quote[]

  @@index([categoryId])
  @@index([city, status])
  @@map("quote_requests")
}

model Quote {
  id              String   @id @default(uuid()) @db.Uuid
  requestId       String?  @map("request_id") @db.Uuid
  // Keşif kataloğu bağı (bağımsız uzmanlarda dolu; profil/puan gösterimi için)
  professionalId  String?  @map("professional_id") @db.Uuid
  // §5.2 Faz A — teklifi veren uzmanın HESABI (bildirim + mükerrer teklif önleme)
  userId          String?  @map("user_id") @db.Uuid
  price           Decimal  @db.Decimal(12, 2)
  // §A2 akıllı fiyatlama — ölü saat/son dakika indirimi (tavan %30; komisyon indirimli fiyattan)
  discountPercent Int      @default(0) @map("discount_percent")
  discountReason  String   @default("") @map("discount_reason") // off_peak | last_minute | flash
  etaMin          Int      @map("eta_min")
  note            String?
  // Uzmanın önerdiği müsait başlangıçlar (UTC ms listesi, JSON)
  slotsJson       String   @default("[]") @map("slots_json")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  professional Professional? @relation(fields: [professionalId], references: [id])
  request      QuoteRequest? @relation(fields: [requestId], references: [id])

  @@unique([requestId, userId]) // uzman başına 1 teklif
  @@index([requestId])
  @@map("quotes")
}

// --- İşletme & uzman kaydı (Build Brief §3) ---

enum BusinessStatus {
  pending
  approved
  rejected
  needs_docs // §3 — ek belge gerekli (admin geri gönderdi)
  under_review // §3 — belge incelemede
}

// §3.1 — KZ işletme türü. Seçime göre zorunlu resmî alanlar değişir.
enum BusinessEntityType {
  llp // ТОО / LLP — tüzel kişi (BİN)
  ip // ИП — bireysel girişimci (IIN)
  freelance // serbest çalışan uzman
  branch // salon şubesi
}

model Business {
  id               String              @id @default(uuid()) @db.Uuid
  ownerUserId      String              @map("owner_user_id") @db.Uuid
  name             String // marka / görünen ad
  ownerName        String              @default("") @map("owner_name")
  sector           String              @default("")
  about            String              @default("")
  city             String              @default("")
  district         String              @default("")
  address          String              @default("")
  // §5.1.4 — kayıtta haritadan iğneyle seçilen gerçek konum (keşif haritasında salonun yeri)
  lat              Float?
  lng              Float?
  phone            String              @default("")
  email            String              @default("")
  workingHours     String              @default("") @map("working_hours")
  taxId            String              @default("") @map("tax_id")
  categories       String[]            @default([])
  photos           String[]            @default([])
  docUrl           String?             @map("doc_url")
  // §3.1/§3.2 — resmî işletme kimliği (KZ)
  entityType       BusinessEntityType? @map("entity_type")
  bin              String              @default("") // BİN (LLP, 12 hane) veya IIN (ИП, 12 hane) — gizli, yalnız doğrulama
  legalName        String              @default("") @map("legal_name") // resmî tüzel/işletme adı
  managerName      String              @default("") @map("manager_name") // yönetici/yetkili (LLP)
  oked             String              @default("") // OKED faaliyet kodu
  vatPayer         Boolean             @default(false) @map("vat_payer") // KDV mükellefi mi
  foundedYear      Int?                @map("founded_year")
  womenOnly        Boolean             @default(false) @map("women_only") // kadınlara özel mi
  docType          String              @default("") @map("doc_type") // yüklenen belgenin türü
  // §3.3 — KATMANLI doğrulama rozetleri (admin/otomatik işaretler)
  identityVerified Boolean             @default(false) @map("identity_verified")
  businessVerified Boolean             @default(false) @map("business_verified")
  binVerified      Boolean             @default(false) @map("bin_verified")
  addressVerified  Boolean             @default(false) @map("address_verified")
  socialVerified   Boolean             @default(false) @map("social_verified")
  // §5.5 — sosyal medya sahiplik doğrulama (kod-bio yöntemi, Faz 4)
  socialInstagram  String              @default("") @map("social_instagram")
  socialTiktok     String              @default("") @map("social_tiktok")
  socialVerifyCode String              @default("") @map("social_verify_code")
  // Keşif listesine (professionals) köprü — salon panelinde randevu/yorum kapsamı için
  professionalId   String?             @map("professional_id")
  status           BusinessStatus      @default(pending)
  rejectReason     String?             @map("reject_reason")
  reviewNote       String?             @map("review_note") // admin notu (ek belge sebebi vb.)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status])
  @@index([ownerUserId])
  @@index([bin])
  @@map("businesses")
}

enum SpecialistKind {
  salon_bound
  independent
}

model Specialist {
  // Faz 4 — salon-takvim yetki modu (uzman kendisi seçer; varsayılan güvenli)
  calendarPermission CalendarPermission @default(create_requires_approval) @map("calendar_permission")
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  businessId         String?            @map("business_id") @db.Uuid
  // §7 — uzmanın keşif kataloğundaki karşılığı (Professional.id); yorumlar subjectId = bu id.
  proId              String?            @map("pro_id")
  kind               SpecialistKind     @default(independent)
  bio                String             @default("")
  certificates       String[]           @default([])
  featured           Boolean            @default(false)
  /// Brief §4.7/§4.8 — GÖRÜNMEZLİK CEZASI. Bu tarihe kadar uzman haritada ve
  /// aramada çıkmaz. Uzman no-show'unda ve aylık 3 ücretsiz iptal hakkı
  /// aşıldığında 1 hafta uygulanır.
  ///
  /// Hesabı KAPATMAK yerine görünürlüğü kesmek bilinçli: mevcut randevuları
  /// devam eder, yalnız yeni iş almaz. Ceza müşteriyi de cezalandırmamalı.
  hiddenUntil        DateTime?          @map("hidden_until") @db.Timestamptz(6)
  /// Aylık ücretsiz iptal sayacı (§4.7: ayda 3). Ay değişince sıfırlanır;
  /// hangi aya ait olduğu `cancelCountMonth` ile tutulur.
  cancelCount        Int                @default(0) @map("cancel_count")
  cancelCountMonth   String             @default("") @map("cancel_count_month") // "2026-08"
  // §uzman onboarding — resmî/kimlik & katmanlı doğrulama (salon epic paralel)
  // entityType: freelance (serbest, kayıtsız) | ip (kayıtlı bireysel girişimci ИП)
  entityType         String             @default("freelance") @map("entity_type")
  iin                String             @default("") // 12 hane; yalnızca kayıtlı ИП uzmanlar; public'te ASLA açık dönmez
  // Katmanlı rozet bayrakları (kimlik = User.kycStatus; diğerleri admin/otomatik)
  certVerified       Boolean            @default(false) @map("cert_verified")
  socialVerified     Boolean            @default(false) @map("social_verified")
  socialInstagram    String             @default("") @map("social_instagram")
  socialVerifyCode   String             @default("") @map("social_verify_code")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([businessId])
  @@map("specialists")
}

enum InviteCodeStatus {
